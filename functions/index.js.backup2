// SECTION 11: FIRESTORE TRIGGERS (AUTOMATIC EVENTS)
// ═══════════════════════════════════════════════════════════════════════════

/**
 * Trigger when a new job is created
 * Notifies admin users
 */
exports.onJobCreated = functions.firestore
  .document('jobs/{jobId}')
  .onCreate(async (snap, context) => {
    try {
      const jobData = snap.data();
      const jobId = context.params.jobId;
      
      console.log(`New job created: ${jobId}`);
      
      // Get all admin users
      const adminsSnapshot = await db.collection('users')
        .where('role', 'in', ['admin', 'super_admin'])
        .get();
      
      // Send notification to all admins
      const batch = db.batch();
      
      adminsSnapshot.forEach((doc) => {
        const notificationRef = db.collection('notifications').doc();
        batch.set(notificationRef, {
          userId: doc.id,
          type: 'new_job',
          title: 'New Job Posted',
          message: `${jobData.title} - ${jobData.location?.city || 'Location not specified'}`,
          data: { jobId },
          read: false,
          createdAt: admin.firestore.FieldValue.serverTimestamp(),
        });
      });
      
      await batch.commit();
      
      console.log(`Notified ${adminsSnapshot.size} admins about new job`);
      
      return null;
    } catch (error) {
      console.error('Error in onJobCreated trigger:', error);
      return null;
    }
  });

/**
 * Trigger when a review is created
 * Updates target's average rating automatically
 */
exports.onReviewCreated = functions.firestore
  .document('reviews/{reviewId}')
  .onCreate(async (snap, context) => {
    try {
      const reviewData = snap.data();
      const { targetId, targetType, rating } = reviewData;
      
      console.log(`New review created for ${targetType}/${targetId}`);
      
      // Get target document
      const targetRef = db.collection(targetType).doc(targetId);
      const targetDoc = await targetRef.get();
      
      if (!targetDoc.exists) {
        console.error(`Target not found: ${targetType}/${targetId}`);
        return null;
      }
      
      const targetData = targetDoc.data();
      const currentRating = targetData.averageRating || 0;
      const reviewCount = targetData.reviewCount || 0;
      
      const newReviewCount = reviewCount + 1;
      const newAverageRating = ((currentRating * reviewCount) + rating) / newReviewCount;
      
      // Update target
      await targetRef.update({
        averageRating: newAverageRating,
        reviewCount: newReviewCount,
        updatedAt: admin.firestore.FieldValue.serverTimestamp(),
      });
      
      console.log(`Updated ${targetType}/${targetId} rating to ${newAverageRating}`);
      
      // Notify owner
      let ownerId = null;
      if (targetType === 'products') {
        ownerId = targetData.sellerId;
      } else if (targetType === 'jobs') {
        ownerId = targetData.employerId;
      } else if (targetType === 'services' || targetType === 'rentals') {
        ownerId = targetData.providerId;
      }
      
      if (ownerId) {
        await sendNotification(
          ownerId,
          'new_review',
          'New Review',
          `You received a ${rating}-star review`,
          { 
            reviewId: context.params.reviewId, 
            targetId, 
            targetType, 
            rating 
          }
        );
      }
      
      return null;
    } catch (error) {
      console.error('Error in onReviewCreated trigger:', error);
      return null;
    }
  });

/**
 * Scheduled function to check and expire subscriptions
 * Runs every 24 hours
 */
exports.checkExpiredSubscriptions = functions.pubsub
  .schedule('every 24 hours')
  .timeZone('Africa/Douala')
  .onRun(async (context) => {
    try {
      console.log('Checking for expired subscriptions...');
      
      const now = admin.firestore.Timestamp.now();
      
      // Get all expired subscriptions
      const expiredSubscriptions = await db.collection('subscriptions')
        .where('status', '==', 'active')
        .where('expiryDate', '<=', now)
        .get();
      
      console.log(`Found ${expiredSubscriptions.size} expired subscriptions`);
      
      if (expiredSubscriptions.empty) {
        console.log('No expired subscriptions found');
        return null;
      }
      
      const batch = db.batch();
      
      expiredSubscriptions.forEach((doc) => {
        const subData = doc.data();
        
        // Update subscription status
        batch.update(doc.ref, {
          status: 'expired',
          updatedAt: admin.firestore.FieldValue.serverTimestamp(),
        });
        
        // Downgrade user to free tier
        batch.update(db.collection('users').doc(subData.userId), {
          subscriptionTier: 'free',
          subscriptionId: null,
          subscriptionExpiry: null,
          updatedAt: admin.firestore.FieldValue.serverTimestamp(),
        });
        
        // Create notification
        const notificationRef = db.collection('notifications').doc();
        batch.set(notificationRef, {
          userId: subData.userId,
          type: 'subscription_expired',
          title: 'Subscription Expired',
          message: 'Your subscription has expired. Renew now to continue enjoying premium features!',
          data: { subscriptionId: doc.id },
          read: false,
          createdAt: admin.firestore.FieldValue.serverTimestamp(),
        });
      });
      
      await batch.commit();
      
      console.log(`Processed ${expiredSubscriptions.size} expired subscriptions`);
      
      return null;
    } catch (error) {
      console.error('Error checking expired subscriptions:', error);
      return null;
    }
  });

/**
 * Trigger when user is deleted
 * Cleans up associated data
 */
exports.onUserDeleted = functions.firestore
  .document('users/{userId}')
  .onDelete(async (snap, context) => {
    try {
      const userId = context.params.userId;
      
      console.log(`User deleted: ${userId}. Cleaning up data...`);
      
      // Delete associated data
      const batch = db.batch();
      
      // Delete Zerm balance
      const zermBalanceRef = db.collection('zermBalances').doc(userId);
      batch.delete(zermBalanceRef);
      
      // Get and delete all user's transactions
      const transactions = await db.collection('zermTransactions')
        .where('userId', '==', userId)
        .limit(500)
        .get();
      
      transactions.forEach((doc) => {
        batch.delete(doc.ref);
      });
      
      // Get and delete all user's notifications
      const notifications = await db.collection('notifications')
        .where('userId', '==', userId)
        .limit(500)
        .get();
      
      notifications.forEach((doc) => {
        batch.delete(doc.ref);
      });
      
      await batch.commit();
      
      console.log(`Cleaned up data for deleted user: ${userId}`);
      
      return null;
    } catch (error) {
      console.error('Error in onUserDeleted trigger:', error);
      return null;
    }
  });
