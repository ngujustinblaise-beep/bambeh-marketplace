/**
 * Create subscription
 * POST /api/subscriptions/create
 * Body: { tier, duration, paymentMethod, amount, paymentReference }
 * Requires: Authentication
 */
app.post('/subscriptions/create', async (req, res) => {
  try {
    const user = await verifyAuth(req, res);
    if (!user) return;
    
    const { tier, duration, paymentMethod, amount, paymentReference } = req.body;
    
    // Validation
    if (!tier || !duration || !paymentMethod || !amount) {
      return res.status(400).json({ 
        success: false,
        error: 'Validation failed',
        message: 'tier, duration, paymentMethod, and amount are required' 
      });
    }
    
    const validTiers = ['basic', 'premium', 'enterprise'];
    const validDurations = ['monthly', 'quarterly', 'yearly'];
    
    if (!validTiers.includes(tier)) {
      return res.status(400).json({ 
        success: false,
        error: 'Validation failed',
        message: 'Invalid subscription tier' 
      });
    }
    
    if (!validDurations.includes(duration)) {
      return res.status(400).json({ 
        success: false,
        error: 'Validation failed',
        message: 'Invalid duration. Must be monthly, quarterly, or yearly' 
      });
    }
    
    // Verify payment amount matches tier pricing
    const expectedAmount = CONFIG.SUBSCRIPTION_PRICES[tier][duration];
    if (amount !== expectedAmount) {
      return res.status(400).json({ 
        success: false,
        error: 'Validation failed',
        message: `Amount mismatch. Expected ${expectedAmount} XAF for ${tier} ${duration}` 
      });
    }
    
    // Calculate expiry date
    const startDate = new Date();
    const expiryDate = new Date(startDate);
    
    switch (duration) {
      case 'monthly':
        expiryDate.setMonth(expiryDate.getMonth() + 1);
        break;
      case 'quarterly':
        expiryDate.setMonth(expiryDate.getMonth() + 3);
        break;
      case 'yearly':
        expiryDate.setFullYear(expiryDate.getFullYear() + 1);
        break;
    }
    
    // Create subscription record
    const subscriptionData = {
      userId: user.uid,
      tier,
      duration,
      amount,
      currency: 'XAF',
      paymentMethod,
      paymentReference: paymentReference || null,
      status: 'active',
      startDate: admin.firestore.Timestamp.fromDate(startDate),
      expiryDate: admin.firestore.Timestamp.fromDate(expiryDate),
      autoRenew: true,
      createdAt: admin.firestore.FieldValue.serverTimestamp(),
      updatedAt: admin.firestore.FieldValue.serverTimestamp(),
    };
    
    const subscriptionRef = await db.collection('subscriptions').add(subscriptionData);
    
    // Update user subscription tier
    await db.collection('users').doc(user.uid).update({
      subscriptionTier: tier,
      subscriptionId: subscriptionRef.id,
      subscriptionExpiry: admin.firestore.Timestamp.fromDate(expiryDate),
      updatedAt: admin.firestore.FieldValue.serverTimestamp(),
    });
    
    // Award welcome Zerm Coins bonus
    const bonusCoins = CONFIG.SUBSCRIPTION_PRICES[tier].bonusCoins;
    
    if (bonusCoins > 0) {
      const balanceRef = db.collection('zermBalances').doc(user.uid);
      const transactionRef = db.collection('zermTransactions').doc();
      
      await db.runTransaction(async (transaction) => {
        const balanceDoc = await transaction.get(balanceRef);
        const currentBalance = balanceDoc.exists ? balanceDoc.data().balance : 0;
        const totalEarned = balanceDoc.exists ? balanceDoc.data().totalEarned : 0;
        const newBalance = currentBalance + bonusCoins;
        
        transaction.set(balanceRef, {
          userId: user.uid,
          balance: newBalance,
          totalEarned: totalEarned + bonusCoins,
          totalSpent: balanceDoc.exists ? balanceDoc.data().totalSpent : 0,
          lastUpdated: admin.firestore.FieldValue.serverTimestamp(),
        }, { merge: true });
        
        transaction.set(transactionRef, {
          userId: user.uid,
          amount: bonusCoins,
          type: 'credit',
          reason: `${tier.charAt(0).toUpperCase() + tier.slice(1)} subscription welcome bonus`,
          transactionId: `sub-bonus-${subscriptionRef.id}`,
          previousBalance: currentBalance,
          newBalance,
          status: 'completed',
          createdAt: admin.firestore.FieldValue.serverTimestamp(),
        });
        
        transaction.update(db.collection('users').doc(user.uid), {
          zermBalance: newBalance,
        });
      });
    }
    
    // Send notification
    await sendNotification(
      user.uid,
      'subscription_activated',
      'Subscription Activated',
      `Your ${tier.charAt(0).toUpperCase() + tier.slice(1)} subscription is now active! You received ${bonusCoins} bonus Zerm Coins.`,
      { 
        subscriptionId: subscriptionRef.id,
        tier,
        bonusCoins,
        expiryDate: expiryDate.toISOString()
      }
    );
    
    // Log activity
    await logActivity(user.uid, 'subscription_created', {
      tier,
      duration,
      amount,
      subscriptionId: subscriptionRef.id
    });
    
    res.status(201).json({
      success: true,
      message: 'Subscription created successfully',
      data: {
        subscriptionId: subscriptionRef.id,
        tier,
        duration,
        expiryDate: expiryDate.toISOString(),
        bonusCoins,
      }
    });
  } catch (error) {
    console.error('Error creating subscription:', error);
    res.status(500).json({ 
      success: false,
      error: error.message 
    });
  }
});

/**
 * Get user subscription
 * GET /api/subscriptions/:userId
 * Requires: Authentication
 */
app.get('/subscriptions/:userId', async (req, res) => {
  try {
    const user = await verifyAuth(req, res);
    if (!user) return;
    
    const { userId } = req.params;
    
    // Users can only view their own subscription unless they're admin
    if (userId !== user.uid && !(await isAdmin(user.uid))) {
      return res.status(403).json({ 
        success: false,
        error: 'Forbidden' 
      });
    }
    
    const userDoc = await db.collection('users').doc(userId).get();
    
    if (!userDoc.exists) {
      return res.status(404).json({ 
        success: false,
        error: 'Not found',
        message: 'User not found' 
      });
    }
    
    const userData = userDoc.data();
    
    if (!userData.subscriptionId) {
      return res.json({
        success: true,
        data: {
          tier: 'free',
          status: 'active',
          message: 'User is on free plan'
        }
      });
    }
    
    const subscriptionDoc = await db.collection('subscriptions').doc(userData.subscriptionId).get();
    
    if (!subscriptionDoc.exists) {
      return res.status(404).json({ 
        success: false,
        error: 'Not found',
        message: 'Subscription not found' 
      });
    }
    
    const subscriptionData = subscriptionDoc.data();
    
    res.json({
      success: true,
      data: {
        id: subscriptionDoc.id,
        ...subscriptionData,
        startDate: subscriptionData.startDate?.toDate().toISOString(),
        expiryDate: subscriptionData.expiryDate?.toDate().toISOString(),
        createdAt: subscriptionData.createdAt?.toDate().toISOString(),
      }
    });
  } catch (error) {
    console.error('Error getting subscription:', error);
    res.status(500).json({ 
      success: false,
      error: error.message 
    });
  }
});

/**
 * Cancel subscription
 * POST /api/subscriptions/:subscriptionId/cancel
 * Requires: Authentication
 */
app.post('/subscriptions/:subscriptionId/cancel', async (req, res) => {
  try {
    const user = await verifyAuth(req, res);
    if (!user) return;
    
    const { subscriptionId } = req.params;
    
    const subscriptionDoc = await db.collection('subscriptions').doc(subscriptionId).get();
    
    if (!subscriptionDoc.exists) {
      return res.status(404).json({ 
        success: false,
        error: 'Not found',
        message: 'Subscription not found' 
      });
    }
    
    const subscriptionData = subscriptionDoc.data();
    
    // Only the subscription owner or admin can cancel
    if (subscriptionData.userId !== user.uid && !(await isAdmin(user.uid))) {
      return res.status(403).json({ 
        success: false,
        error: 'Forbidden' 
      });
    }
    
    // Update subscription to turn off auto-renew
    await db.collection('subscriptions').doc(subscriptionId).update({
      autoRenew: false,
      cancelledAt: admin.firestore.FieldValue.serverTimestamp(),
      updatedAt: admin.firestore.FieldValue.serverTimestamp(),
    });
    
    // Send notification
    await sendNotification(
      subscriptionData.userId,
      'subscription_cancelled',
      'Subscription Cancelled',
      'Your subscription has been cancelled. You can continue using premium features until the end of your billing period.',
      { subscriptionId }
    );
    
    // Log activity
    await logActivity(subscriptionData.userId, 'subscription_cancelled', {
      subscriptionId,
      cancelledBy: user.uid
    });
    
    res.json({
      success: true,
      message: 'Subscription cancelled successfully. Premium features will remain active until expiry date.',
      data: {
        subscriptionId,
        expiryDate: subscriptionData.expiryDate?.toDate().toISOString()
      }
    });
  } catch (error) {
    console.error('Error cancelling subscription:', error);
    res.status(500).json({ 
      success: false,
      error: error.message 
    });
  }
});
