// SECTION 5: PAYMENT INTEGRATION (MTN & ORANGE MONEY)
// ═══════════════════════════════════════════════════════════════════════════

/**
 * MTN Mobile Money Webhook
 * POST /api/payments/mtn/webhook
 * Handles payment confirmations from MTN MOMO
 */
app.post('/payments/mtn/webhook', async (req, res) => {
  try {
    const { 
      transactionId, 
      status, 
      amount, 
      userId, 
      phoneNumber,
      metadata 
    } = req.body;
    
    console.log('MTN Webhook received:', req.body);
    
    // Validate required fields
    if (!transactionId || !status || !amount || !userId) {
      return res.status(400).json({ 
        success: false,
        error: 'Validation failed',
        message: 'Missing required fields' 
      });
    }
    
    // Record payment in database
    const paymentData = {
      transactionId,
      userId,
      provider: 'MTN_MOMO',
      phoneNumber: phoneNumber || null,
      amount,
      currency: 'XAF',
      status: status.toLowerCase(),
      metadata: metadata || {},
      createdAt: admin.firestore.FieldValue.serverTimestamp(),
      updatedAt: admin.firestore.FieldValue.serverTimestamp(),
    };
    
    await db.collection('payments').doc(transactionId).set(paymentData);
    
    // If payment successful, process it
    if (status.toUpperCase() === 'SUCCESSFUL' || status.toUpperCase() === 'SUCCESS') {
      // Convert XAF to Zerm Coins
      const zermAmount = Math.floor(amount * CONFIG.XAF_TO_ZERM_RATE);
      
      if (zermAmount > 0) {
        const balanceRef = db.collection('zermBalances').doc(userId);
        const transactionRef = db.collection('zermTransactions').doc();
        
        await db.runTransaction(async (transaction) => {
          const balanceDoc = await transaction.get(balanceRef);
          const currentBalance = balanceDoc.exists ? balanceDoc.data().balance : 0;
          const totalEarned = balanceDoc.exists ? balanceDoc.data().totalEarned : 0;
          const newBalance = currentBalance + zermAmount;
          
          transaction.set(balanceRef, {
            userId,
            balance: newBalance,
            totalEarned: totalEarned + zermAmount,
            totalSpent: balanceDoc.exists ? balanceDoc.data().totalSpent : 0,
            lastUpdated: admin.firestore.FieldValue.serverTimestamp(),
          }, { merge: true });
          
          transaction.set(transactionRef, {
            userId,
            amount: zermAmount,
            type: 'credit',
            reason: 'MTN Mobile Money purchase',
            transactionId,
            previousBalance: currentBalance,
            newBalance,
            paymentProvider: 'MTN_MOMO',
            paymentAmount: amount,
            paymentCurrency: 'XAF',
            status: 'completed',
            createdAt: admin.firestore.FieldValue.serverTimestamp(),
          });
          
          transaction.update(db.collection('users').doc(userId), {
            zermBalance: newBalance,
          });
        });
        
        // Send success notification
        await sendNotification(
          userId,
          'payment_success',
          'Payment Successful',
          `Your payment of ${amount} XAF was successful! You received ${zermAmount} Zerm Coins.`,
          { 
            amount,
            zermAmount,
            transactionId,
            provider: 'MTN_MOMO'
          }
        );
        
        // Log activity
        await logActivity(userId, 'payment_received', {
          provider: 'MTN_MOMO',
          amount,
          zermAmount,
          transactionId
        });
      }
    } else {
      // Payment failed - notify user
      await sendNotification(
        userId,
        'payment_failed',
        'Payment Failed',
        `Your payment of ${amount} XAF could not be processed. Please try again.`,
        { 
          amount,
          transactionId,
          provider: 'MTN_MOMO',
          status
        }
      );
    }
    
    res.json({ 
      success: true, 
      message: 'Webhook processed successfully' 
    });
  } catch (error) {
    console.error('Error handling MTN webhook:', error);
    res.status(500).json({ 
      success: false,
      error: error.message 
    });
  }
});

