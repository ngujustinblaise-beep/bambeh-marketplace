// SECTION 8: ORDER MANAGEMENT
// ═══════════════════════════════════════════════════════════════════════════

/**
 * Create new order
 * POST /api/orders
 * Body: { products, totalPrice, deliveryAddress, paymentMethod }
 * Requires: Authentication
 */
app.post('/orders', async (req, res) => {
  try {
    const user = await verifyAuth(req, res);
    if (!user) return;
    
    const { 
      products, 
      totalPrice, 
      deliveryAddress,
      paymentMethod,
      notes
    } = req.body;
    
    // Validation
    if (!products || !Array.isArray(products) || products.length === 0) {
      return res.status(400).json({ 
        success: false,
        error: 'Validation failed',
        message: 'products array is required and must not be empty' 
      });
    }
    
    if (!totalPrice || totalPrice <= 0) {
      return res.status(400).json({ 
        success: false,
        error: 'Validation failed',
        message: 'Valid totalPrice is required' 
      });
    }
    
    if (!deliveryAddress) {
      return res.status(400).json({ 
        success: false,
        error: 'Validation failed',
        message: 'deliveryAddress is required' 
      });
    }
    
    // Validate products and calculate actual total
    let calculatedTotal = 0;
    const validatedProducts = [];
    
    for (const item of products) {
      const productDoc = await db.collection('products').doc(item.productId).get();
      
      if (!productDoc.exists) {
        return res.status(404).json({ 
          success: false,
          error: 'Not found',
          message: `Product not found: ${item.productId}` 
        });
      }
      
      const productData = productDoc.data();
      
      if (productData.status !== 'active') {
        return res.status(400).json({ 
          success: false,
          error: 'Product unavailable',
          message: `Product is not available: ${productData.name}` 
        });
      }
      
      const itemTotal = productData.price * (item.quantity || 1);
      calculatedTotal += itemTotal;
      
      validatedProducts.push({
        productId: item.productId,
        name: productData.name,
        price: productData.price,
        quantity: item.quantity || 1,
        sellerId: productData.sellerId,
        subtotal: itemTotal
      });
    }
    
    // Verify calculated total matches provided total
    if (Math.abs(calculatedTotal - totalPrice) > 0.01) {
      return res.status(400).json({ 
        success: false,
        error: 'Validation failed',
        message: 'Total price mismatch' 
      });
    }
    
    // Create order
    const orderData = {
      userId: user.uid,
      products: validatedProducts,
      totalPrice: calculatedTotal,
      currency: 'XAF',
      deliveryAddress,
      paymentMethod: paymentMethod || 'pending',
      notes: notes || '',
      status: 'pending',
      paymentStatus: 'pending',
      trackingNumber: null,
      createdAt: admin.firestore.FieldValue.serverTimestamp(),
      updatedAt: admin.firestore.FieldValue.serverTimestamp(),
    };
    
    const orderRef = await db.collection('orders').add(orderData);
    
    // Update sold count for each product
    const batch = db.batch();
    for (const item of validatedProducts) {
      const productRef = db.collection('products').doc(item.productId);
      batch.update(productRef, {
        soldCount: admin.firestore.FieldValue.increment(item.quantity)
      });
    }
    await batch.commit();
    
    // Send notification to buyer
    await sendNotification(
      user.uid,
      'order_created',
      'Order Placed',
      `Your order #${orderRef.id.slice(-8)} has been placed successfully.`,
      { orderId: orderRef.id, totalPrice }
    );
    
    // Notify sellers
    const uniqueSellers = [...new Set(validatedProducts.map(p => p.sellerId))];
    for (const sellerId of uniqueSellers) {
      await sendNotification(
        sellerId,
        'new_order',
        'New Order Received',
        `You have received a new order for your products.`,
        { orderId: orderRef.id }
      );
    }
    
    // Log activity
    await logActivity(user.uid, 'order_created', {
      orderId: orderRef.id,
      totalPrice,
      productCount: products.length
    });
    
    res.status(201).json({
      success: true,
      message: 'Order created successfully',
      data: {
        id: orderRef.id,
        ...orderData
      }
    });
  } catch (error) {
    console.error('Error creating order:', error);
    res.status(500).json({ 
      success: false,
      error: error.message 
    });
  }
});

/**
 * Get user orders
 * GET /api/orders?userId=USER_ID&status=pending
 * Requires: Authentication
 */
app.get('/orders', async (req, res) => {
  try {
    const user = await verifyAuth(req, res);
    if (!user) return;
    
    const { userId, status } = req.query;
    
    const targetUserId = userId || user.uid;
    
    // Users can only view their own orders unless they're admin
    if (targetUserId !== user.uid && !(await isAdmin(user.uid))) {
      return res.status(403).json({ 
        success: false,
        error: 'Forbidden' 
      });
    }
    
    const { page, limit, offset } = calculatePagination(
      req.query.page,
      req.query.limit
    );
    
    let query = db.collection('orders').where('userId', '==', targetUserId);
    
    if (status) {
      query = query.where('status', '==', status);
    }
    
    const ordersSnapshot = await query
      .orderBy('createdAt', 'desc')
      .limit(limit)
      .offset(offset)
      .get();
    
    const orders = ordersSnapshot.docs.map(doc => ({
      id: doc.id,
      ...doc.data(),
      createdAt: doc.data().createdAt?.toDate().toISOString(),
      updatedAt: doc.data().updatedAt?.toDate().toISOString()
    }));
    
    res.json({
      success: true,
      data: orders,
      pagination: {
        page,
        limit,
        count: orders.length,
        hasMore: orders.length === limit
      }
    });
  } catch (error) {
    console.error('Error getting orders:', error);
    res.status(500).json({ 
      success: false,
      error: error.message 
    });
  }
});

/**
 * Get single order
 * GET /api/orders/:orderId
 * Requires: Authentication
 */
app.get('/orders/:orderId', async (req, res) => {
  try {
    const user = await verifyAuth(req, res);
    if (!user) return;
    
    const { orderId } = req.params;
    
    const orderDoc = await db.collection('orders').doc(orderId).get();
    
    if (!orderDoc.exists) {
      return res.status(404).json({ 
        success: false,
        error: 'Not found',
        message: 'Order not found' 
      });
    }
    
    const orderData = orderDoc.data();
    
    // Users can only view their own orders unless they're admin or a seller
    const isSeller = orderData.products.some(p => p.sellerId === user.uid);
    
    if (orderData.userId !== user.uid && !isSeller && !(await isAdmin(user.uid))) {
      return res.status(403).json({ 
        success: false,
        error: 'Forbidden' 
      });
    }
    
    res.json({
      success: true,
      data: {
        id: orderDoc.id,
        ...orderData,
        createdAt: orderData.createdAt?.toDate().toISOString(),
        updatedAt: orderData.updatedAt?.toDate().toISOString()
      }
    });
  } catch (error) {
    console.error('Error getting order:', error);
    res.status(500).json({ 
      success: false,
      error: error.message 
    });
  }
});

/**
 * Update order status
 * PUT /api/orders/:orderId/status
 * Body: { status, trackingNumber }
 * Requires: Authentication (seller or admin)
 */
app.put('/orders/:orderId/status', async (req, res) => {
  try {
    const user = await verifyAuth(req, res);
    if (!user) return;
    
    const { orderId } = req.params;
    const { status, trackingNumber } = req.body;
    
    const validStatuses = ['pending', 'processing', 'shipped', 'delivered', 'cancelled'];
    
    if (!status || !validStatuses.includes(status)) {
      return res.status(400).json({ 
        success: false,
        error: 'Validation failed',
        message: 'Valid status is required' 
      });
    }
    
    const orderDoc = await db.collection('orders').doc(orderId).get();
    
    if (!orderDoc.exists) {
      return res.status(404).json({ 
        success: false,
        error: 'Not found',
        message: 'Order not found' 
      });
    }
    
    const orderData = orderDoc.data();
    
    // Only sellers of the products or admin can update status
    const isSeller = orderData.products.some(p => p.sellerId === user.uid);
    
    if (!isSeller && !(await isAdmin(user.uid))) {
      return res.status(403).json({ 
        success: false,
        error: 'Forbidden' 
      });
    }
    
    const updateData = {
      status,
      updatedAt: admin.firestore.FieldValue.serverTimestamp(),
    };
    
    if (trackingNumber) {
      updateData.trackingNumber = trackingNumber;
    }
    
    await db.collection('orders').doc(orderId).update(updateData);
    
    // Send notification to buyer
    await sendNotification(
      orderData.userId,
      'order_status_updated',
      'Order Status Updated',
      `Your order #${orderId.slice(-8)} status has been updated to: ${status}`,
      { orderId, status, trackingNumber }
    );
    
    // Log activity
    await logActivity(user.uid, 'order_status_updated', {
      orderId,
      newStatus: status,
      trackingNumber
    });
    
    res.json({
      success: true,
      message: 'Order status updated successfully',
      data: updateData
    });
  } catch (error) {
    console.error('Error updating order status:', error);
    res.status(500).json({ 
      success: false,
      error: error.message 
    });
  }
});
// ═══════════════════════════════════════════════════════════════════════════
// SECTION 9: REVIEW & RATING SYSTEM
// ═══════════════════════════════════════════════════════════════════════════

/**
 * Create review
 * POST /api/reviews
 * Body: { targetId, targetType, rating, comment, images }
 * Requires: Authentication
 */
app.post('/reviews', async (req, res) => {
  try {
    const user = await verifyAuth(req, res);
    if (!user) return;
    
    const { 
      targetId, 
      targetType, 
      rating, 
      comment,
      images
    } = req.body;
    
    // Validation
    const validTypes = ['products', 'jobs', 'services', 'rentals', 'users'];
    
    if (!targetId || !targetType || !validTypes.includes(targetType)) {
      return res.status(400).json({ 
        success: false,
        error: 'Validation failed',
        message: 'Valid targetId and targetType are required' 
      });
    }
    
    if (!rating || rating < 1 || rating > 5) {
      return res.status(400).json({ 
        success: false,
        error: 'Validation failed',
        message: 'Rating must be between 1 and 5' 
      });
    }
    
    // Check if target exists
    const targetDoc = await db.collection(targetType).doc(targetId).get();
    
    if (!targetDoc.exists) {
      return res.status(404).json({ 
        success: false,
        error: 'Not found',
        message: `${targetType.slice(0, -1)} not found` 
      });
    }
    
    // Check if user already reviewed this target
    const existingReview = await db.collection('reviews')
      .where('targetId', '==', targetId)
      .where('targetType', '==', targetType)
      .where('reviewerId', '==', user.uid)
      .limit(1)
      .get();
    
    if (!existingReview.empty) {
      return res.status(400).json({ 
        success: false,
        error: 'Already reviewed',
        message: 'You have already reviewed this item' 
      });
    }
    
    // Create review
    const reviewData = {
      targetId,
      targetType,
      reviewerId: user.uid,
      rating: parseInt(rating),
      comment: comment || '',
      images: images || [],
      helpful: 0,
      reported: false,
      status: 'active',
      createdAt: admin.firestore.FieldValue.serverTimestamp(),
      updatedAt: admin.firestore.FieldValue.serverTimestamp(),
    };
    
    const reviewRef = await db.collection('reviews').add(reviewData);
    
    // Update target's average rating
    const targetData = targetDoc.data();
    const currentRating = targetData.averageRating || 0;
    const reviewCount = targetData.reviewCount || 0;
    const newReviewCount = reviewCount + 1;
    const newAverageRating = ((currentRating * reviewCount) + rating) / newReviewCount;
    
    await db.collection(targetType).doc(targetId).update({
      averageRating: newAverageRating,
      reviewCount: newReviewCount,
      updatedAt: admin.firestore.FieldValue.serverTimestamp(),
    });
    
    // Notify the owner
    let ownerId = null;
    if (targetType === 'products') {
      ownerId = targetData.sellerId;
    } else if (targetType === 'jobs') {
      ownerId = targetData.employerId;
    } else if (targetType === 'services' || targetType === 'rentals') {
      ownerId = targetData.providerId;
    }
    
    if (ownerId) {
      await sendNotification(
        ownerId,
        'new_review',
        'New Review',
        `You received a ${rating}-star review`,
        { reviewId: reviewRef.id, targetId, targetType, rating }
      );
    }
    
    // Log activity
    await logActivity(user.uid, 'review_created', {
      reviewId: reviewRef.id,
      targetId,
      targetType,
      rating
    });
    
    res.status(201).json({
      success: true,
      message: 'Review submitted successfully',
      data: {
        id: reviewRef.id,
        ...reviewData
      }
    });
  } catch (error) {
    console.error('Error creating review:', error);
    res.status(500).json({ 
      success: false,
      error: error.message 
    });
  }
});

/**
 * Get reviews for a target
 * GET /api/reviews?targetId=XXX&targetType=products&page=1&limit=20
 */
app.get('/reviews', async (req, res) => {
  try {
    const { targetId, targetType } = req.query;
    
    if (!targetId || !targetType) {
      return res.status(400).json({ 
        success: false,
        error: 'Validation failed',
        message: 'targetId and targetType are required' 
      });
    }
    
    const { page, limit, offset } = calculatePagination(
      req.query.page,
      req.query.limit
    );
    
    const reviewsSnapshot = await db.collection('reviews')
      .where('targetId', '==', targetId)
      .where('targetType', '==', targetType)
      .where('status', '==', 'active')
      .orderBy('createdAt', 'desc')
      .limit(limit)
      .offset(offset)
      .get();
    
    const reviews = await Promise.all(reviewsSnapshot.docs.map(async (doc) => {
      const reviewData = doc.data();
      
      // Get reviewer info
      const reviewerDoc = await db.collection('users').doc(reviewData.reviewerId).get();
      const reviewerInfo = reviewerDoc.exists ? {
        id: reviewerDoc.id,
        displayName: reviewerDoc.data().displayName,
        avatar: reviewerDoc.data().avatar,
      } : null;
      
      return {
        id: doc.id,
        ...reviewData,
        reviewer: reviewerInfo,
        createdAt: reviewData.createdAt?.toDate().toISOString()
      };
    }));
    
    res.json({
      success: true,
      data: reviews,
      pagination: {
        page,
        limit,
        count: reviews.length,
        hasMore: reviews.length === limit
      }
    });
  } catch (error) {
    console.error('Error getting reviews:', error);
    res.status(500).json({ 
      success: false,
      error: error.message 
    });
  }
});
// ═══════════════════════════════════════════════════════════════════════════
// SECTION 10: NOTIFICATION SYSTEM
// ═══════════════════════════════════════════════════════════════════════════

/**
 * Get user notifications
 * GET /api/notifications?userId=USER_ID&unreadOnly=true
 * Requires: Authentication
 */
app.get('/notifications', async (req, res) => {
  try {
    const user = await verifyAuth(req, res);
    if (!user) return;
    
    const { userId, unreadOnly } = req.query;
    
    const targetUserId = userId || user.uid;
    
    // Users can only view their own notifications
    if (targetUserId !== user.uid) {
      return res.status(403).json({ 
        success: false,
        error: 'Forbidden' 
      });
    }
    
    const { page, limit, offset } = calculatePagination(
      req.query.page,
      req.query.limit
    );
    
    let query = db.collection('notifications').where('userId', '==', targetUserId);
    
    if (unreadOnly === 'true') {
      query = query.where('read', '==', false);
    }
    
    const notificationsSnapshot = await query
      .orderBy('createdAt', 'desc')
      .limit(limit)
      .offset(offset)
      .get();
    
    const notifications = notificationsSnapshot.docs.map(doc => ({
      id: doc.id,
      ...doc.data(),
      createdAt: doc.data().createdAt?.toDate().toISOString()
    }));
    
    res.json({
      success: true,
      data: notifications,
      pagination: {
        page,
        limit,
        count: notifications.length,
        hasMore: notifications.length === limit
      }
    });
  } catch (error) {
    console.error('Error getting notifications:', error);
    res.status(500).json({ 
      success: false,
      error: error.message 
    });
  }
});

/**
 * Mark notification as read
 * PUT /api/notifications/:notificationId/read
 * Requires: Authentication
 */
app.put('/notifications/:notificationId/read', async (req, res) => {
  try {
    const user = await verifyAuth(req, res);
    if (!user) return;
    
    const { notificationId } = req.params;
    
    const notificationDoc = await db.collection('notifications').doc(notificationId).get();
    
    if (!notificationDoc.exists) {
      return res.status(404).json({ 
        success: false,
        error: 'Not found',
        message: 'Notification not found' 
      });
    }
    
    const notificationData = notificationDoc.data();
    
    // Users can only mark their own notifications as read
    if (notificationData.userId !== user.uid) {
      return res.status(403).json({ 
        success: false,
        error: 'Forbidden' 
      });
    }
    
    await db.collection('notifications').doc(notificationId).update({
      read: true,
      readAt: admin.firestore.FieldValue.serverTimestamp(),
    });
    
    res.json({
      success: true,
      message: 'Notification marked as read'
    });
  } catch (error) {
    console.error('Error marking notification as read:', error);
    res.status(500).json({ 
      success: false,
      error: error.message 
    });
  }
});

/**
 * Mark all notifications as read
 * PUT /api/notifications/read-all
 * Requires: Authentication
 */
app.put('/notifications/read-all', async (req, res) => {
  try {
    const user = await verifyAuth(req, res);
    if (!user) return;
    
    const unreadNotifications = await db.collection('notifications')
      .where('userId', '==', user.uid)
      .where('read', '==', false)
      .get();
    
    const batch = db.batch();
    
    unreadNotifications.docs.forEach((doc) => {
      batch.update(doc.ref, {
        read: true,
        readAt: admin.firestore.FieldValue.serverTimestamp(),
      });
    });
    
    await batch.commit();
    
    res.json({
      success: true,
      message: `${unreadNotifications.size} notifications marked as read`,
      count: unreadNotifications.size
    });
  } catch (error) {
    console.error('Error marking all notifications as read:', error);
    res.status(500).json({ 
      success: false,
      error: error.message 
    });
  }
});

/**
 * Delete notification
 * DELETE /api/notifications/:notificationId
 * Requires: Authentication
 */
app.delete('/notifications/:notificationId', async (req, res) => {
  try {
    const user = await verifyAuth(req, res);
    if (!user) return;
    
    const { notificationId } = req.params;
    
    const notificationDoc = await db.collection('notifications').doc(notificationId).get();
    
    if (!notificationDoc.exists) {
      return res.status(404).json({ 
        success: false,
        error: 'Not found',
        message: 'Notification not found' 
      });
    }
    
    const notificationData = notificationDoc.data();
    
    // Users can only delete their own notifications
    if (notificationData.userId !== user.uid) {
      return res.status(403).json({ 
        success: false,
        error: 'Forbidden' 
      });
    }
    
    await db.collection('notifications').doc(notificationId).delete();
    
    res.json({
      success: true,
      message: 'Notification deleted'
    });
  } catch (error) {
    console.error('Error deleting notification:', error);
    res.status(500).json({ 
      success: false,
      error: error.message 
    });
  }
});
