/**
 * Create new user
 * POST /api/users/create
 * Body: { email, password, displayName, phoneNumber, language }
 */
app.post('/users/create', async (req, res) => {
  try {
    const { email, password, displayName, phoneNumber, language } = req.body;
    
    // Validation
    if (!email || !password) {
      return res.status(400).json({ 
        success: false,
        error: 'Validation failed',
        message: 'Email and password are required' 
      });
    }
    
    if (password.length < 6) {
      return res.status(400).json({ 
        success: false,
        error: 'Validation failed',
        message: 'Password must be at least 6 characters' 
      });
    }
    
    // Validate phone number if provided
    let phoneProvider = null;
    if (phoneNumber) {
      const phoneValidation = validateCameroonPhone(phoneNumber);
      if (!phoneValidation.valid) {
        return res.status(400).json({ 
          success: false,
          error: 'Validation failed',
          message: 'Invalid Cameroon phone number' 
        });
      }
      phoneProvider = phoneValidation.provider;
    }
    
    // Create Firebase Auth user
    const userRecord = await auth.createUser({
      email,
      password,
      displayName: displayName || email.split('@')[0],
      phoneNumber: phoneNumber || null,
      emailVerified: false,
    });
    
    // Create Firestore user document
    const userData = {
      uid: userRecord.uid,
      email,
      displayName: displayName || email.split('@')[0],
      phoneNumber: phoneNumber || null,
      phoneProvider,
      language: language || 'en',
      subscriptionTier: 'free',
      subscriptionId: null,
      subscriptionExpiry: null,
      zermBalance: 0,
      role: 'user',
      isActive: true,
      isVerified: false,
      avatar: null,
      location: {
        country: 'Cameroon',
        city: '',
        region: ''
      },
      preferences: {
        notifications: true,
        emailNotifications: true,
        language: language || 'en'
      },
      createdAt: admin.firestore.FieldValue.serverTimestamp(),
      updatedAt: admin.firestore.FieldValue.serverTimestamp(),
      lastLoginAt: null,
    };
    
    await db.collection('users').doc(userRecord.uid).set(userData);
    
    // Initialize Zerm balance
    await db.collection('zermBalances').doc(userRecord.uid).set({
      userId: userRecord.uid,
      balance: 0,
      totalEarned: 0,
      totalSpent: 0,
      lastUpdated: admin.firestore.FieldValue.serverTimestamp(),
    });
    
    // Send welcome notification
    await sendNotification(
      userRecord.uid,
      'welcome',
      'Welcome to Bambé Marketplace!',
      'Thank you for joining Cameroon\'s premier marketplace platform. Start exploring jobs, products, and services today!',
      { isWelcome: true }
    );
    
    // Log activity
    await logActivity(userRecord.uid, 'user_created', {
      email,
      phoneProvider,
    });
    
    res.status(201).json({
      success: true,
      message: 'User created successfully',
      data: {
        uid: userRecord.uid,
        email: userData.email,
        displayName: userData.displayName,
        subscriptionTier: 'free',
        zermBalance: 0,
      }
    });
  } catch (error) {
    console.error('Error creating user:', error);
    
    let errorMessage = error.message;
    if (error.code === 'auth/email-already-exists') {
      errorMessage = 'Email address is already in use';
    } else if (error.code === 'auth/invalid-email') {
      errorMessage = 'Invalid email address';
    } else if (error.code === 'auth/invalid-password') {
      errorMessage = 'Password is too weak';
    }
    
    res.status(400).json({ 
      success: false,
      error: errorMessage 
    });
  }
});

/**
 * Get user profile
 * GET /api/users/:userId
 * Requires: Authentication
 */
app.get('/users/:userId', async (req, res) => {
  try {
    const user = await verifyAuth(req, res);
    if (!user) return;
    
    const { userId } = req.params;
    
    // Users can only view their own profile unless they're admin
    if (userId !== user.uid && !(await isAdmin(user.uid))) {
      return res.status(403).json({ 
        success: false,
        error: 'Forbidden',
        message: 'You can only view your own profile' 
      });
    }
    
    const userDoc = await db.collection('users').doc(userId).get();
    
    if (!userDoc.exists) {
      return res.status(404).json({ 
        success: false,
        error: 'Not found',
        message: 'User not found' 
      });
    }
    
    // Get Zerm balance
    const zermBalanceDoc = await db.collection('zermBalances').doc(userId).get();
    const zermBalance = zermBalanceDoc.exists ? zermBalanceDoc.data() : { balance: 0 };
    
    // Get subscription details if active
    let subscriptionDetails = null;
    const userData = userDoc.data();
    
    if (userData.subscriptionId) {
      const subDoc = await db.collection('subscriptions').doc(userData.subscriptionId).get();
      if (subDoc.exists) {
        subscriptionDetails = subDoc.data();
      }
    }
    
    res.json({
      success: true,
      data: {
        ...userData,
        zermBalance: zermBalance.balance || 0,
        totalEarned: zermBalance.totalEarned || 0,
        totalSpent: zermBalance.totalSpent || 0,
        subscription: subscriptionDetails,
      }
    });
  } catch (error) {
    console.error('Error getting user profile:', error);
    res.status(500).json({ 
      success: false,
      error: error.message 
    });
  }
});

/**
 * Update user profile
 * PUT /api/users/:userId
 * Requires: Authentication
 */
app.put('/users/:userId', async (req, res) => {
  try {
    const user = await verifyAuth(req, res);
    if (!user) return;
    
    const { userId } = req.params;
    
    // Users can only update their own profile unless they're admin
    if (userId !== user.uid && !(await isAdmin(user.uid))) {
      return res.status(403).json({ 
        success: false,
        error: 'Forbidden',
        message: 'You can only update your own profile' 
      });
    }
    
    const userDoc = await db.collection('users').doc(userId).get();
    
    if (!userDoc.exists) {
      return res.status(404).json({ 
        success: false,
        error: 'Not found',
        message: 'User not found' 
      });
    }
    
    // Extract allowed fields for update
    const allowedFields = [
      'displayName',
      'avatar',
      'phoneNumber',
      'language',
      'location',
      'preferences',
      'bio',
    ];
    
    const updateData = {};
    
    for (const field of allowedFields) {
      if (req.body[field] !== undefined) {
        updateData[field] = req.body[field];
      }
    }
    
    // Validate phone number if being updated
    if (updateData.phoneNumber) {
      const phoneValidation = validateCameroonPhone(updateData.phoneNumber);
      if (!phoneValidation.valid) {
        return res.status(400).json({ 
          success: false,
          error: 'Validation failed',
          message: 'Invalid Cameroon phone number' 
        });
      }
      updateData.phoneProvider = phoneValidation.provider;
    }
    
    updateData.updatedAt = admin.firestore.FieldValue.serverTimestamp();
    
    await db.collection('users').doc(userId).update(updateData);
    
    // Log activity
    await logActivity(userId, 'profile_updated', {
      updatedFields: Object.keys(updateData)
    });
    
    res.json({
      success: true,
      message: 'Profile updated successfully',
      data: updateData
    });
  } catch (error) {
    console.error('Error updating user profile:', error);
    res.status(500).json({ 
      success: false,
      error: error.message 
    });
  }
});

/**
 * Update last login timestamp
 * POST /api/users/:userId/login
 * Requires: Authentication
 */
app.post('/users/:userId/login', async (req, res) => {
  try {
    const user = await verifyAuth(req, res);
    if (!user) return;
    
    const { userId } = req.params;
    
    if (userId !== user.uid) {
      return res.status(403).json({ 
        success: false,
        error: 'Forbidden' 
      });
    }
    
    await db.collection('users').doc(userId).update({
      lastLoginAt: admin.firestore.FieldValue.serverTimestamp(),
    });
    
    res.json({
      success: true,
      message: 'Login recorded'
    });
  } catch (error) {
    console.error('Error recording login:', error);
    res.status(500).json({ 
      success: false,
      error: error.message 
    });
  }
});
