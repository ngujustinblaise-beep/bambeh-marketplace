/**
 * Verify Firebase Authentication Token
 * @param {Object} req - Express request object
 * @param {Object} res - Express response object
 * @returns {Object|null} - Decoded token or null if invalid
 */
async function verifyAuth(req, res) {
  try {
    const authHeader = req.headers.authorization;
    
    if (!authHeader || !authHeader.startsWith('Bearer ')) {
      res.status(401).json({ 
        success: false,
        error: 'Unauthorized',
        message: 'No authentication token provided' 
      });
      return null;
    }
    
    const token = authHeader.split('Bearer ')[1];
    const decodedToken = await auth.verifyIdToken(token);
    
    return decodedToken;
  } catch (error) {
    console.error('Auth verification error:', error);
    res.status(401).json({ 
      success: false,
      error: 'Unauthorized',
      message: 'Invalid or expired token' 
    });
    return null;
  }
}

/**
 * Check if user has admin role
 * @param {string} uid - User ID
 * @returns {Promise<boolean>}
 */
async function isAdmin(uid) {
  try {
    const userDoc = await db.collection('users').doc(uid).get();
    if (!userDoc.exists) return false;
    
    const userData = userDoc.data();
    return userData.role === 'admin' || userData.role === 'super_admin';
  } catch (error) {
    console.error('Error checking admin status:', error);
    return false;
  }
}

/**
 * Check if user has premium subscription
 * @param {string} uid - User ID
 * @returns {Promise<boolean>}
 */
async function isPremium(uid) {
  try {
    const userDoc = await db.collection('users').doc(uid).get();
    if (!userDoc.exists) return false;
    
    const tier = userDoc.data().subscriptionTier;
    return tier === 'premium' || tier === 'enterprise';
  } catch (error) {
    console.error('Error checking premium status:', error);
    return false;
  }
}

/**
 * Check if user has active subscription
 * @param {string} uid - User ID
 * @returns {Promise<boolean>}
 */
async function hasActiveSubscription(uid) {
  try {
    const userDoc = await db.collection('users').doc(uid).get();
    if (!userDoc.exists) return false;
    
    const userData = userDoc.data();
    
    if (userData.subscriptionTier === 'free') return false;
    
    if (!userData.subscriptionExpiry) return false;
    
    const expiry = userData.subscriptionExpiry.toDate();
    const now = new Date();
    
    return expiry > now;
  } catch (error) {
    console.error('Error checking subscription status:', error);
    return false;
  }
}

/**
 * Validate phone number for Cameroon
 * @param {string} phone - Phone number
 * @returns {Object} - { valid: boolean, provider: string|null }
 */
function validateCameroonPhone(phone) {
  // Remove spaces, dashes, and country code
  const cleaned = phone.replace(/[\s\-+]/g, '');
  
  // Check if it's a valid Cameroon number (9 digits)
  if (cleaned.length !== 9) {
    return { valid: false, provider: null };
  }
  
  const prefix = cleaned.substring(0, 3);
  
  if (CONFIG.MTN_PREFIXES.includes(prefix)) {
    return { valid: true, provider: 'MTN_MOMO' };
  }
  
  if (CONFIG.ORANGE_PREFIXES.includes(prefix)) {
    return { valid: true, provider: 'ORANGE_MONEY' };
  }
  
  return { valid: false, provider: null };
}

/**
 * Generate transaction ID
 * @returns {string}
 */
function generateTransactionId() {
  const timestamp = Date.now();
  const random = Math.floor(Math.random() * 1000000);
  return `TXN-${timestamp}-${random}`;
}

/**
 * Calculate pagination
 * @param {number} page - Page number
 * @param {number} limit - Items per page
 * @returns {Object} - { offset, limit }
 */
function calculatePagination(page = 1, limit = CONFIG.DEFAULT_PAGE_SIZE) {
  const pageNum = Math.max(1, parseInt(page));
  const limitNum = Math.min(
    Math.max(1, parseInt(limit)),
    CONFIG.MAX_PAGE_SIZE
  );
  
  return {
    offset: (pageNum - 1) * limitNum,
    limit: limitNum,
    page: pageNum
  };
}

/**
 * Send notification to user
 * @param {string} userId - User ID
 * @param {string} type - Notification type
 * @param {string} title - Notification title
 * @param {string} message - Notification message
 * @param {Object} data - Additional data
 */
async function sendNotification(userId, type, title, message, data = {}) {
  try {
    await db.collection('notifications').add({
      userId,
      type,
      title,
      message,
      data,
      read: false,
      createdAt: admin.firestore.FieldValue.serverTimestamp(),
    });
    
    console.log(`Notification sent to user ${userId}: ${type}`);
  } catch (error) {
    console.error('Error sending notification:', error);
  }
}

/**
 * Log activity for audit trail
 * @param {string} userId - User ID
 * @param {string} action - Action performed
 * @param {Object} details - Action details
 */
async function logActivity(userId, action, details = {}) {
  try {
    await db.collection('activityLogs').add({
      userId,
      action,
      details,
      timestamp: admin.firestore.FieldValue.serverTimestamp(),
      ip: details.ip || 'unknown',
      userAgent: details.userAgent || 'unknown',
    });
  } catch (error) {
    console.error('Error logging activity:', error);
  }
}

