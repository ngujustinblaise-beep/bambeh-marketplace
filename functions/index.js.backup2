/**
 * Apply for a job
 * POST /api/jobs/:jobId/apply
 * Body: { resume, coverLetter, contactInfo }
 * Requires: Authentication
 */
app.post('/jobs/:jobId/apply', async (req, res) => {
  try {
    const user = await verifyAuth(req, res);
    if (!user) return;
    
    const { jobId } = req.params;
    const { resume, coverLetter, contactInfo } = req.body;
    
    // Check if job exists
    const jobDoc = await db.collection('jobs').doc(jobId).get();
    
    if (!jobDoc.exists) {
      return res.status(404).json({ 
        success: false,
        error: 'Not found',
        message: 'Job not found' 
      });
    }
    
    const jobData = jobDoc.data();
    
    // Check if already applied
    const existingApplication = await db.collection('jobApplications')
      .where('jobId', '==', jobId)
      .where('applicantId', '==', user.uid)
      .limit(1)
      .get();
    
    if (!existingApplication.empty) {
      return res.status(400).json({ 
        success: false,
        error: 'Already applied',
        message: 'You have already applied for this job' 
      });
    }
    
    // Create application
    const applicationData = {
      jobId,
      applicantId: user.uid,
      employerId: jobData.employerId,
      resume: resume || null,
      coverLetter: coverLetter || '',
      contactInfo: contactInfo || {},
      status: 'pending',
      createdAt: admin.firestore.FieldValue.serverTimestamp(),
      updatedAt: admin.firestore.FieldValue.serverTimestamp(),
    };
    
    const applicationRef = await db.collection('jobApplications').add(applicationData);
    
    // Increment applicant count
    await db.collection('jobs').doc(jobId).update({
      applicantCount: admin.firestore.FieldValue.increment(1)
    });
    
    // Notify employer
    await sendNotification(
      jobData.employerId,
      'new_job_application',
      'New Job Application',
      `Someone applied for your job: ${jobData.title}`,
      { jobId, applicationId: applicationRef.id }
    );
    
    // Notify applicant
    await sendNotification(
      user.uid,
      'application_submitted',
      'Application Submitted',
      `Your application for "${jobData.title}" has been submitted successfully.`,
      { jobId, applicationId: applicationRef.id }
    );
    
    // Log activity
    await logActivity(user.uid, 'job_applied', {
      jobId,
      applicationId: applicationRef.id,
      jobTitle: jobData.title
    });
    
    res.status(201).json({
      success: true,
      message: 'Application submitted successfully',
      data: {
        id: applicationRef.id,
        jobId,
        status: 'pending'
      }
    });
  } catch (error) {
    console.error('Error applying for job:', error);
    res.status(500).json({ 
      success: false,
      error: error.message 
    });
  }
});
