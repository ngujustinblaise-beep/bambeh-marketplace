/**
 * Get Zerm Coins balance
 * GET /api/zerm/balance/:userId
 * Requires: Authentication
 */
app.get('/zerm/balance/:userId', async (req, res) => {
  try {
    const user = await verifyAuth(req, res);
    if (!user) return;
    
    const { userId } = req.params;
    
    // Users can only view their own balance unless they're admin
    if (userId !== user.uid && !(await isAdmin(user.uid))) {
      return res.status(403).json({ 
        success: false,
        error: 'Forbidden' 
      });
    }
    
    const balanceDoc = await db.collection('zermBalances').doc(userId).get();
    
    if (!balanceDoc.exists) {
      return res.status(404).json({ 
        success: false,
        error: 'Not found',
        message: 'Balance record not found' 
      });
    }
    
    res.json({
      success: true,
      data: balanceDoc.data()
    });
  } catch (error) {
    console.error('Error getting Zerm balance:', error);
    res.status(500).json({ 
      success: false,
      error: error.message 
    });
  }
});

/**
 * Add Zerm Coins to user account
 * POST /api/zerm/add
 * Body: { userId, amount, reason, transactionId }
 * Requires: Authentication (admin or self for purchases)
 */
app.post('/zerm/add', async (req, res) => {
  try {
    const user = await verifyAuth(req, res);
    if (!user) return;
    
    const { userId, amount, reason, transactionId } = req.body;
    
    // Validation
    if (!userId || !amount || !reason) {
      return res.status(400).json({ 
        success: false,
        error: 'Validation failed',
        message: 'userId, amount, and reason are required' 
      });
    }
    
    if (amount <= 0) {
      return res.status(400).json({ 
        success: false,
        error: 'Validation failed',
        message: 'Amount must be positive' 
      });
    }
    
    // Only admin or the user themselves can add coins
    if (userId !== user.uid && !(await isAdmin(user.uid))) {
      return res.status(403).json({ 
        success: false,
        error: 'Forbidden' 
      });
    }
    
    const balanceRef = db.collection('zermBalances').doc(userId);
    const transactionRef = db.collection('zermTransactions').doc();
    const finalTransactionId = transactionId || generateTransactionId();
    
    // Use Firestore transaction for atomicity
    await db.runTransaction(async (transaction) => {
      const balanceDoc = await transaction.get(balanceRef);
      
      const currentBalance = balanceDoc.exists ? balanceDoc.data().balance : 0;
      const totalEarned = balanceDoc.exists ? balanceDoc.data().totalEarned : 0;
      const newBalance = currentBalance + amount;
      const newTotalEarned = totalEarned + amount;
      
      // Update balance
      transaction.set(balanceRef, {
        userId,
        balance: newBalance,
        totalEarned: newTotalEarned,
        totalSpent: balanceDoc.exists ? balanceDoc.data().totalSpent : 0,
        lastUpdated: admin.firestore.FieldValue.serverTimestamp(),
      }, { merge: true });
      
      // Record transaction
      transaction.set(transactionRef, {
        userId,
        amount,
        type: 'credit',
        reason,
        transactionId: finalTransactionId,
        previousBalance: currentBalance,
        newBalance,
        status: 'completed',
        createdAt: admin.firestore.FieldValue.serverTimestamp(),
      });
      
      // Update user document
      transaction.update(db.collection('users').doc(userId), {
        zermBalance: newBalance,
      });
    });
    
    // Send notification
    await sendNotification(
      userId,
      'zerm_credit',
      'Zerm Coins Added',
      `${amount} Zerm Coins have been added to your account. ${reason}`,
      { amount, transactionId: finalTransactionId }
    );
    
    // Log activity
    await logActivity(userId, 'zerm_added', {
      amount,
      reason,
      transactionId: finalTransactionId,
      addedBy: user.uid
    });
    
    res.json({
      success: true,
      message: 'Zerm Coins added successfully',
      data: {
        transactionId: finalTransactionId,
        amount,
        reason
      }
    });
  } catch (error) {
    console.error('Error adding Zerm Coins:', error);
    res.status(500).json({ 
      success: false,
      error: error.message 
    });
  }
});

/**
 * Deduct Zerm Coins from user account
 * POST /api/zerm/deduct
 * Body: { userId, amount, reason, transactionId }
 * Requires: Authentication (admin or self for purchases)
 */
app.post('/zerm/deduct', async (req, res) => {
  try {
    const user = await verifyAuth(req, res);
    if (!user) return;
    
    const { userId, amount, reason, transactionId } = req.body;
    
    // Validation
    if (!userId || !amount || !reason) {
      return res.status(400).json({ 
        success: false,
        error: 'Validation failed',
        message: 'userId, amount, and reason are required' 
      });
    }
    
    if (amount <= 0) {
      return res.status(400).json({ 
        success: false,
        error: 'Validation failed',
        message: 'Amount must be positive' 
      });
    }
    
    // Only admin or the user themselves can deduct coins
    if (userId !== user.uid && !(await isAdmin(user.uid))) {
      return res.status(403).json({ 
        success: false,
        error: 'Forbidden' 
      });
    }
    
    const balanceRef = db.collection('zermBalances').doc(userId);
    const transactionRef = db.collection('zermTransactions').doc();
    const finalTransactionId = transactionId || generateTransactionId();
    
    // Use Firestore transaction for atomicity
    let result;
    
    try {
      result = await db.runTransaction(async (transaction) => {
        const balanceDoc = await transaction.get(balanceRef);
        
        if (!balanceDoc.exists) {
          throw new Error('User balance not found');
        }
        
        const currentBalance = balanceDoc.data().balance;
        const totalSpent = balanceDoc.data().totalSpent || 0;
        
        if (currentBalance < amount) {
          throw new Error('Insufficient Zerm Coins balance');
        }
        
        const newBalance = currentBalance - amount;
        const newTotalSpent = totalSpent + amount;
        
        // Update balance
        transaction.update(balanceRef, {
          balance: newBalance,
          totalSpent: newTotalSpent,
          lastUpdated: admin.firestore.FieldValue.serverTimestamp(),
        });
        
        // Record transaction
        transaction.set(transactionRef, {
          userId,
          amount,
          type: 'debit',
          reason,
          transactionId: finalTransactionId,
          previousBalance: currentBalance,
          newBalance,
          status: 'completed',
          createdAt: admin.firestore.FieldValue.serverTimestamp(),
        });
        
        // Update user document
        transaction.update(db.collection('users').doc(userId), {
          zermBalance: newBalance,
        });
        
        return { success: true, newBalance };
      });
    } catch (txError) {
      return res.status(400).json({ 
        success: false,
        error: txError.message 
      });
    }
    
    // Send notification
    await sendNotification(
      userId,
      'zerm_debit',
      'Zerm Coins Deducted',
      `${amount} Zerm Coins have been deducted from your account. ${reason}`,
      { amount, transactionId: finalTransactionId }
    );
    
    // Log activity
    await logActivity(userId, 'zerm_deducted', {
      amount,
      reason,
      transactionId: finalTransactionId,
      deductedBy: user.uid
    });
    
    res.json({
      success: true,
      message: 'Zerm Coins deducted successfully',
      data: {
        transactionId: finalTransactionId,
        amount,
        reason,
        newBalance: result.newBalance
      }
    });
  } catch (error) {
    console.error('Error deducting Zerm Coins:', error);
    res.status(500).json({ 
      success: false,
      error: error.message 
    });
  }
});

/**
 * Get Zerm transaction history
 * GET /api/zerm/transactions/:userId?limit=20&offset=0
 * Requires: Authentication
 */
app.get('/zerm/transactions/:userId', async (req, res) => {
  try {
    const user = await verifyAuth(req, res);
    if (!user) return;
    
    const { userId } = req.params;
    
    // Users can only view their own transactions unless they're admin
    if (userId !== user.uid && !(await isAdmin(user.uid))) {
      return res.status(403).json({ 
        success: false,
        error: 'Forbidden' 
      });
    }
    
    const { page, limit, offset } = calculatePagination(
      req.query.page,
      req.query.limit
    );
    
    const transactionsSnapshot = await db.collection('zermTransactions')
      .where('userId', '==', userId)
      .orderBy('createdAt', 'desc')
      .limit(limit)
      .offset(offset)
      .get();
    
    const transactions = transactionsSnapshot.docs.map(doc => ({
      id: doc.id,
      ...doc.data(),
      createdAt: doc.data().createdAt?.toDate().toISOString()
    }));
    
    res.json({
      success: true,
      data: transactions,
      pagination: {
        page,
        limit,
        count: transactions.length,
        hasMore: transactions.length === limit
      }
    });
  } catch (error) {
    console.error('Error getting Zerm transactions:', error);
    res.status(500).json({ 
      success: false,
      error: error.message 
    });
  }
});
