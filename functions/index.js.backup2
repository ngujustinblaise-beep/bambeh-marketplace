// SECTION 6: PRODUCT MANAGEMENT
// ═══════════════════════════════════════════════════════════════════════════

/**
 * Get all products with filters
 * GET /api/products?category=electronics&minPrice=1000&maxPrice=50000&page=1&limit=20
 */
app.get('/products', async (req, res) => {
  try {
    const { 
      category, 
      minPrice, 
      maxPrice, 
      condition,
      sellerId,
      search
    } = req.query;
    
    const { page, limit, offset } = calculatePagination(
      req.query.page,
      req.query.limit
    );
    
    let query = db.collection('products').where('status', '==', 'active');
    
    // Apply filters
    if (category) {
      query = query.where('category', '==', category);
    }
    
    if (sellerId) {
      query = query.where('sellerId', '==', sellerId);
    }
    
    if (condition) {
      query = query.where('condition', '==', condition);
    }
    
    // Note: Firestore doesn't support multiple inequality filters
    // So price filtering will be done in memory
    
    const snapshot = await query
      .orderBy('createdAt', 'desc')
      .limit(limit + offset)
      .get();
    
    let products = snapshot.docs.map(doc => ({
      id: doc.id,
      ...doc.data(),
      createdAt: doc.data().createdAt?.toDate().toISOString(),
      updatedAt: doc.data().updatedAt?.toDate().toISOString()
    }));
    
    // Apply price filters in memory
    if (minPrice) {
      products = products.filter(p => p.price >= parseFloat(minPrice));
    }
    
    if (maxPrice) {
      products = products.filter(p => p.price <= parseFloat(maxPrice));
    }
    
    // Apply search filter
    if (search) {
      const searchLower = search.toLowerCase();
      products = products.filter(p => 
        p.name?.toLowerCase().includes(searchLower) ||
        p.description?.toLowerCase().includes(searchLower) ||
        p.tags?.some(tag => tag.toLowerCase().includes(searchLower))
      );
    }
    
    // Apply pagination
    const paginatedProducts = products.slice(offset, offset + limit);
    
    res.json({
      success: true,
      data: paginatedProducts,
      pagination: {
        page,
        limit,
        count: paginatedProducts.length,
        total: products.length,
        hasMore: (offset + limit) < products.length
      }
    });
  } catch (error) {
    console.error('Error getting products:', error);
    res.status(500).json({ 
      success: false,
      error: error.message 
    });
  }
});

/**
 * Get single product
 * GET /api/products/:productId
 */
app.get('/products/:productId', async (req, res) => {
  try {
    const { productId } = req.params;
    
    const productDoc = await db.collection('products').doc(productId).get();
    
    if (!productDoc.exists) {
      return res.status(404).json({ 
        success: false,
        error: 'Not found',
        message: 'Product not found' 
      });
    }
    
    const productData = productDoc.data();
    
    // Get seller info
    const sellerDoc = await db.collection('users').doc(productData.sellerId).get();
    const sellerInfo = sellerDoc.exists ? {
      id: sellerDoc.id,
      displayName: sellerDoc.data().displayName,
      avatar: sellerDoc.data().avatar,
      location: sellerDoc.data().location,
    } : null;
    
    // Increment view count
    await db.collection('products').doc(productId).update({
      viewCount: admin.firestore.FieldValue.increment(1)
    });
    
    res.json({
      success: true,
      data: {
        id: productDoc.id,
        ...productData,
        seller: sellerInfo,
        createdAt: productData.createdAt?.toDate().toISOString(),
        updatedAt: productData.updatedAt?.toDate().toISOString()
      }
    });
  } catch (error) {
    console.error('Error getting product:', error);
    res.status(500).json({ 
      success: false,
      error: error.message 
    });
  }
});

/**
 * Create new product
 * POST /api/products
 * Body: { name, description, price, category, images, condition, location }
 * Requires: Authentication
 */
app.post('/products', async (req, res) => {
  try {
    const user = await verifyAuth(req, res);
    if (!user) return;
    
    const { 
      name, 
      description, 
      price, 
      category, 
      images, 
      condition,
      location,
      tags,
      specifications
    } = req.body;
    
    // Validation
    if (!name || !price || !category) {
      return res.status(400).json({ 
        success: false,
        error: 'Validation failed',
        message: 'name, price, and category are required' 
      });
    }
    
    if (price <= 0) {
      return res.status(400).json({ 
        success: false,
        error: 'Validation failed',
        message: 'Price must be positive' 
      });
    }
    
    const productData = {
      name,
      description: description || '',
      price: parseFloat(price),
      currency: 'XAF',
      category,
      images: images || [],
      condition: condition || 'new',
      location: location || null,
      tags: tags || [],
      specifications: specifications || {},
      sellerId: user.uid,
      status: 'active',
      averageRating: 0,
      reviewCount: 0,
      soldCount: 0,
      viewCount: 0,
      isFeatured: false,
      createdAt: admin.firestore.FieldValue.serverTimestamp(),
      updatedAt: admin.firestore.FieldValue.serverTimestamp(),
    };
    
    const productRef = await db.collection('products').add(productData);
    
    // Send notification
    await sendNotification(
      user.uid,
      'product_created',
      'Product Listed',
      `Your product "${name}" has been successfully listed on Bambé Marketplace.`,
      { productId: productRef.id }
    );
    
    // Log activity
    await logActivity(user.uid, 'product_created', {
      productId: productRef.id,
      name,
      price,
      category
    });
    
    res.status(201).json({
      success: true,
      message: 'Product created successfully',
      data: {
        id: productRef.id,
        ...productData
      }
    });
  } catch (error) {
    console.error('Error creating product:', error);
    res.status(500).json({ 
      success: false,
      error: error.message 
    });
  }
});

/**
 * Update product
 * PUT /api/products/:productId
 * Requires: Authentication (owner or admin)
 */
app.put('/products/:productId', async (req, res) => {
  try {
    const user = await verifyAuth(req, res);
    if (!user) return;
    
    const { productId } = req.params;
    
    const productDoc = await db.collection('products').doc(productId).get();
    
    if (!productDoc.exists) {
      return res.status(404).json({ 
        success: false,
        error: 'Not found',
        message: 'Product not found' 
      });
    }
    
    const productData = productDoc.data();
    
    // Only owner or admin can update
    if (productData.sellerId !== user.uid && !(await isAdmin(user.uid))) {
      return res.status(403).json({ 
        success: false,
        error: 'Forbidden',
        message: 'You can only update your own products' 
      });
    }
    
    // Extract allowed fields for update
    const allowedFields = [
      'name',
      'description',
      'price',
      'category',
      'images',
      'condition',
      'location',
      'tags',
      'specifications',
      'status'
    ];
    
    const updateData = {};
    
    for (const field of allowedFields) {
      if (req.body[field] !== undefined) {
        updateData[field] = req.body[field];
      }
    }
    
    updateData.updatedAt = admin.firestore.FieldValue.serverTimestamp();
    
    await db.collection('products').doc(productId).update(updateData);
    
    // Log activity
    await logActivity(user.uid, 'product_updated', {
      productId,
      updatedFields: Object.keys(updateData)
    });
    
    res.json({
      success: true,
      message: 'Product updated successfully',
      data: updateData
    });
  } catch (error) {
    console.error('Error updating product:', error);
    res.status(500).json({ 
      success: false,
      error: error.message 
    });
  }
});

/**
 * Delete product
 * DELETE /api/products/:productId
 * Requires: Authentication (owner or admin)
 */
app.delete('/products/:productId', async (req, res) => {
  try {
    const user = await verifyAuth(req, res);
    if (!user) return;
    
    const { productId } = req.params;
    
    const productDoc = await db.collection('products').doc(productId).get();
    
    if (!productDoc.exists) {
      return res.status(404).json({ 
        success: false,
        error: 'Not found',
        message: 'Product not found' 
      });
    }
    
    const productData = productDoc.data();
    
    // Only owner or admin can delete
    if (productData.sellerId !== user.uid && !(await isAdmin(user.uid))) {
      return res.status(403).json({ 
        success: false,
        error: 'Forbidden',
        message: 'You can only delete your own products' 
      });
    }
    
    // Soft delete - change status instead of removing
    await db.collection('products').doc(productId).update({
      status: 'deleted',
      deletedAt: admin.firestore.FieldValue.serverTimestamp(),
      updatedAt: admin.firestore.FieldValue.serverTimestamp(),
    });
    
    // Log activity
    await logActivity(user.uid, 'product_deleted', {
      productId,
      productName: productData.name
    });
    
    res.json({
      success: true,
      message: 'Product deleted successfully',
      data: { id: productId }
    });
  } catch (error) {
    console.error('Error deleting product:', error);
    res.status(500).json({ 
      success: false,
      error: error.message 
    });
  }
});
