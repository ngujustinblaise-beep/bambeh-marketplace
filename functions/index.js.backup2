/**
 * Get all jobs with filters
 * GET /api/jobs?category=technology&location=Yaounde&type=full-time&page=1
 */
app.get('/jobs', async (req, res) => {
  try {
    const { 
      category, 
      location, 
      type,
      salaryMin,
      salaryMax,
      employerId
    } = req.query;
    
    const { page, limit, offset } = calculatePagination(
      req.query.page,
      req.query.limit
    );
    
    let query = db.collection('jobs').where('status', '==', 'active');
    
    // Apply filters
    if (category) {
      query = query.where('category', '==', category);
    }
    
    if (type) {
      query = query.where('type', '==', type);
    }
    
    if (employerId) {
      query = query.where('employerId', '==', employerId);
    }
    
    const snapshot = await query
      .orderBy('createdAt', 'desc')
      .limit(limit + offset)
      .get();
    
    let jobs = snapshot.docs.map(doc => ({
      id: doc.id,
      ...doc.data(),
      createdAt: doc.data().createdAt?.toDate().toISOString(),
      updatedAt: doc.data().updatedAt?.toDate().toISOString()
    }));
    
    // Apply location filter in memory
    if (location) {
      const locationLower = location.toLowerCase();
      jobs = jobs.filter(j => 
        j.location?.city?.toLowerCase().includes(locationLower) ||
        j.location?.region?.toLowerCase().includes(locationLower)
      );
    }
    
    // Apply salary filters in memory
    if (salaryMin) {
      jobs = jobs.filter(j => j.salary?.min >= parseFloat(salaryMin));
    }
    
    if (salaryMax) {
      jobs = jobs.filter(j => j.salary?.max <= parseFloat(salaryMax));
    }
    
    // Apply pagination
    const paginatedJobs = jobs.slice(offset, offset + limit);
    
    res.json({
      success: true,
      data: paginatedJobs,
      pagination: {
        page,
        limit,
        count: paginatedJobs.length,
        total: jobs.length,
        hasMore: (offset + limit) < jobs.length
      }
    });
  } catch (error) {
    console.error('Error getting jobs:', error);
    res.status(500).json({ 
      success: false,
      error: error.message 
    });
  }
});

