/**
 * ═══════════════════════════════════════════════════════════════════════════
 * VENDOR PROFILE PAGE - COMPREHENSIVE VENDOR PROFILE WITH VERIFICATION
 * ═══════════════════════════════════════════════════════════════════════════
 * 
 * Features:
 * ✅ Business logo upload
 * ✅ Banner image upload
 * ✅ Business verification (license, tax card upload)
 * ✅ Verified Enterprise badge after admin approval
 * ✅ Account expiry countdown
 * ✅ 4 working days verification notice
 * 
 * FILE LOCATION: src/pages/vendor/VendorProfile.tsx
 * © 2025 Bambeh. All rights reserved.
 * ═══════════════════════════════════════════════════════════════════════════
 */

import { useState, useEffect, useRef } from 'react';
import { Link, useNavigate } from 'react-router-dom';
import {
  Store, ArrowLeft, Camera, Upload, Shield, CheckCircle, Clock, AlertTriangle,
  FileText, Award, Calendar, Star, MapPin, Phone, Mail, Globe, Edit2,
  BadgeCheck, XCircle, Loader2, Image, Crown, Zap, Eye
} from 'lucide-react';

interface VendorData {
  id: string;
  username: string;
  email: string;
  phone: string;
  businessName: string;
  businessDescription: string;
  tier: string;
  vendorTier?: string;
  privilege?: string;
  isMaster?: boolean;
  logoUrl?: string;
  bannerUrl?: string;
  isVerified: boolean;
  verificationStatus: 'none' | 'pending' | 'approved' | 'rejected';
  verificationDocuments?: string[];
  subscriptionExpiry: string;
  rating: number;
  totalSales: number;
  joinedDate: string;
  location: string;
  website?: string;
}

const tierConfig: Record<string, { name: string; icon: any; color: string; bg: string; gradient: string }> = {
  basic: { name: 'Basic', icon: Store, color: 'text-gray-600', bg: 'bg-gray-100', gradient: 'from-gray-500 to-gray-600' },
  starter: { name: 'Starter', icon: Store, color: 'text-gray-600', bg: 'bg-gray-100', gradient: 'from-gray-500 to-gray-600' },
  premium: { name: 'Premium', icon: Zap, color: 'text-blue-600', bg: 'bg-blue-100', gradient: 'from-blue-500 to-cyan-500' },
  professional: { name: 'Professional', icon: Zap, color: 'text-blue-600', bg: 'bg-blue-100', gradient: 'from-blue-500 to-cyan-500' },
  gold: { name: 'Gold', icon: Crown, color: 'text-yellow-600', bg: 'bg-yellow-100', gradient: 'from-yellow-500 to-orange-500' },
  enterprise: { name: 'Enterprise', icon: Crown, color: 'text-purple-600', bg: 'bg-purple-100', gradient: 'from-purple-500 to-pink-500' },
  master: { name: 'Master', icon: Crown, color: 'text-purple-600', bg: 'bg-purple-100', gradient: 'from-purple-500 to-pink-500' }
};

export default function VendorProfile() {
  const navigate = useNavigate();
  const logoInputRef = useRef<HTMLInputElement>(null);
  const bannerInputRef = useRef<HTMLInputElement>(null);
  const documentInputRef = useRef<HTMLInputElement>(null);

  const [vendor, setVendor] = useState<VendorData | null>(null);
  const [isEditing, setIsEditing] = useState(false);
  const [isSaving, setIsSaving] = useState(false);
  const [isUploading, setIsUploading] = useState<'logo' | 'banner' | 'document' | null>(null);
  const [daysUntilExpiry, setDaysUntilExpiry] = useState(0);
  const [showVerificationModal, setShowVerificationModal] = useState(false);
  const [uploadedDocuments, setUploadedDocuments] = useState<File[]>([]);

  const [editForm, setEditForm] = useState({
    businessName: '',
    businessDescription: '',
    phone: '',
    email: '',
    location: '',
    website: ''
  });

  useEffect(() => {
    const vendorData = localStorage.getItem('Bambeh_vendor');
    if (vendorData) {
      const parsed = JSON.parse(vendorData);
      // Map vendorTier/privilege to tier, add defaults
      const fullVendor: VendorData = {
        ...parsed,
        tier: parsed.tier || parsed.vendorTier || parsed.privilege || 'basic',
        vendorTier: parsed.vendorTier || parsed.tier || 'basic',
        privilege: parsed.privilege || 'basic',
        isMaster: parsed.isMaster || false,
        phone: parsed.phone || parsed.phoneNumber || '+237 000000000',
        email: parsed.email || 'vendor@bambeh.com',
        username: parsed.username || 'vendor',
        businessName: parsed.businessName || parsed.fullName || parsed.username || 'My Business',
        isVerified: parsed.verificationStatus === 'approved',
        verificationStatus: parsed.verificationStatus || 'none',
        subscriptionExpiry: parsed.subscriptionExpiry || '2025-12-31',
        rating: parsed.stats?.rating || 4.5,
        totalSales: parsed.stats?.totalSales || 0,
        joinedDate: parsed.joinedDate || '2024-01-15',
        location: parsed.location || 'Yaoundé, Cameroon',
        businessDescription: parsed.businessDescription || 'Welcome to our business!',
        website: parsed.website || ''
      };
      setVendor(fullVendor);
      setEditForm({
        businessName: fullVendor.businessName,
        businessDescription: fullVendor.businessDescription,
        phone: fullVendor.phone,
        email: fullVendor.email,
        location: fullVendor.location,
        website: fullVendor.website || ''
      });

      // Calculate days until expiry
      const expiry = new Date(fullVendor.subscriptionExpiry);
      const today = new Date();
      const diff = Math.ceil((expiry.getTime() - today.getTime()) / (1000 * 60 * 60 * 24));
      setDaysUntilExpiry(diff);
    }
  }, []);

  const handleLogoUpload = async (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (!file) return;

    setIsUploading('logo');
    await new Promise(resolve => setTimeout(resolve, 1500));

    // In production, upload to server and get URL
    const url = URL.createObjectURL(file);
    setVendor(prev => prev ? { ...prev, logoUrl: url } : null);
    setIsUploading(null);
  };

  const handleBannerUpload = async (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (!file) return;

    setIsUploading('banner');
    await new Promise(resolve => setTimeout(resolve, 1500));

    const url = URL.createObjectURL(file);
    setVendor(prev => prev ? { ...prev, bannerUrl: url } : null);
    setIsUploading(null);
  };

  const handleDocumentUpload = (e: React.ChangeEvent<HTMLInputElement>) => {
    const files = e.target.files;
    if (files) {
      setUploadedDocuments(prev => [...prev, ...Array.from(files)]);
    }
  };

  const handleSubmitVerification = async () => {
    if (uploadedDocuments.length === 0) return;

    setIsUploading('document');
    await new Promise(resolve => setTimeout(resolve, 2000));

    // Update vendor verification status
    setVendor(prev => prev ? { ...prev, verificationStatus: 'pending' } : null);
    
    // Save to localStorage
    const vendorData = localStorage.getItem('Bambeh_vendor');
    if (vendorData) {
      const parsed = JSON.parse(vendorData);
      parsed.verificationStatus = 'pending';
      localStorage.setItem('Bambeh_vendor', JSON.stringify(parsed));
    }

    setIsUploading(null);
    setShowVerificationModal(false);
    setUploadedDocuments([]);
  };

  const handleSaveProfile = async () => {
    setIsSaving(true);
    await new Promise(resolve => setTimeout(resolve, 1500));

    const updatedVendor = { ...vendor, ...editForm };
    setVendor(updatedVendor as VendorData);
    localStorage.setItem('Bambeh_vendor', JSON.stringify(updatedVendor));

    setIsSaving(false);
    setIsEditing(false);
  };

  if (!vendor) {
    return (
      <div className="min-h-screen flex items-center justify-center">
        <Loader2 className="w-8 h-8 animate-spin text-purple-600" />
      </div>
    );
  }

  const tier = tierConfig[vendor.tier] || tierConfig[vendor.vendorTier as string] || tierConfig[vendor.privilege as string] || tierConfig.basic;
  const TierIcon = tier.icon;

  const renderVerificationStatus = () => {
    switch (vendor.verificationStatus) {
      case 'approved':
        return (
          <div className="flex items-center gap-2 px-3 py-1.5 bg-green-100 text-green-700 rounded-full">
            <BadgeCheck className="w-4 h-4" />
            <span className="text-sm font-medium">Verified Enterprise</span>
          </div>
        );
      case 'pending':
        return (
          <div className="flex items-center gap-2 px-3 py-1.5 bg-yellow-100 text-yellow-700 rounded-full">
            <Clock className="w-4 h-4" />
            <span className="text-sm font-medium">Verification Pending</span>
          </div>
        );
      case 'rejected':
        return (
          <div className="flex items-center gap-2 px-3 py-1.5 bg-red-100 text-red-700 rounded-full">
            <XCircle className="w-4 h-4" />
            <span className="text-sm font-medium">Verification Rejected</span>
          </div>
        );
      default:
        return (
          <button
            onClick={() => setShowVerificationModal(true)}
            className="flex items-center gap-2 px-3 py-1.5 bg-purple-100 text-purple-700 rounded-full hover:bg-purple-200 transition-colors"
          >
            <Shield className="w-4 h-4" />
            <span className="text-sm font-medium">Get Verified</span>
          </button>
        );
    }
  };

  return (
    <div className="min-h-screen bg-gray-50">
      {/* Header */}
      <header className="bg-gradient-to-r from-purple-700 via-pink-600 to-orange-500 text-white sticky top-0 z-50">
        <div className="container mx-auto px-4 py-4">
          <div className="flex items-center justify-between">
            <div className="flex items-center gap-3">
              <button onClick={() => navigate(-1)} className="p-2 hover:bg-white/20 rounded-lg">
                <ArrowLeft className="w-5 h-5" />
              </button>
              {/* NON-CLICKABLE LOGO */}
              <div className="flex items-center gap-2 select-none pointer-events-none">
                <div className="w-8 h-8 bg-white/20 rounded-lg flex items-center justify-center">
                  <Store className="w-5 h-5" />
                </div>
                <span className="font-bold">Profile</span>
              </div>
            </div>
            <button
              onClick={() => isEditing ? handleSaveProfile() : setIsEditing(true)}
              disabled={isSaving}
              className="flex items-center gap-2 px-4 py-2 bg-white/20 hover:bg-white/30 rounded-lg font-medium transition-colors"
            >
              {isSaving ? (
                <><Loader2 className="w-4 h-4 animate-spin" />Saving...</>
              ) : isEditing ? (
                <><CheckCircle className="w-4 h-4" />Save</>
              ) : (
                <><Edit2 className="w-4 h-4" />Edit</>
              )}
            </button>
          </div>
        </div>
      </header>

      <main className="container mx-auto px-4 py-6">
        {/* Banner Section */}
        <div className="relative h-48 md:h-64 bg-gradient-to-r from-purple-600 to-pink-600 rounded-2xl overflow-hidden mb-16">
          {vendor.bannerUrl ? (
            <img src={vendor.bannerUrl} alt="Banner" className="w-full h-full object-cover" />
          ) : (
            <div className="w-full h-full flex items-center justify-center">
              <Image className="w-16 h-16 text-white/30" />
            </div>
          )}
          
          {/* Banner Upload Button */}
          <button
            onClick={() => bannerInputRef.current?.click()}
            className="absolute bottom-4 right-4 flex items-center gap-2 px-4 py-2 bg-black/50 hover:bg-black/70 text-white rounded-lg transition-colors"
          >
            {isUploading === 'banner' ? (
              <Loader2 className="w-4 h-4 animate-spin" />
            ) : (
              <Camera className="w-4 h-4" />
            )}
            <span className="text-sm">Change Banner</span>
          </button>
          <input
            ref={bannerInputRef}
            type="file"
            accept="image/*"
            onChange={handleBannerUpload}
            className="hidden"
          />

          {/* Logo - Positioned at bottom */}
          <div className="absolute -bottom-12 left-6">
            <div className="relative">
              <div className="w-24 h-24 md:w-32 md:h-32 bg-white rounded-2xl shadow-lg overflow-hidden border-4 border-white">
                {vendor.logoUrl ? (
                  <img src={vendor.logoUrl} alt="Logo" className="w-full h-full object-cover" />
                ) : (
                  <div className="w-full h-full bg-gradient-to-br from-purple-500 to-pink-500 flex items-center justify-center text-white text-3xl font-bold">
                    {vendor.businessName.charAt(0)}
                  </div>
                )}
              </div>
              <button
                onClick={() => logoInputRef.current?.click()}
                className="absolute -bottom-2 -right-2 w-8 h-8 bg-purple-600 hover:bg-purple-700 text-white rounded-full flex items-center justify-center shadow-lg"
              >
                {isUploading === 'logo' ? (
                  <Loader2 className="w-4 h-4 animate-spin" />
                ) : (
                  <Camera className="w-4 h-4" />
                )}
              </button>
              <input
                ref={logoInputRef}
                type="file"
                accept="image/*"
                onChange={handleLogoUpload}
                className="hidden"
              />

              {/* Verification Badge */}
              {vendor.verificationStatus === 'approved' && (
                <div className="absolute -top-2 -right-2 w-8 h-8 bg-green-500 rounded-full flex items-center justify-center shadow-lg">
                  <BadgeCheck className="w-5 h-5 text-white" />
                </div>
              )}
            </div>
          </div>
        </div>

        {/* Profile Info */}
        <div className="bg-white rounded-2xl shadow-sm p-6 mb-6">
          <div className="flex flex-wrap items-start justify-between gap-4 mb-6">
            <div>
              {isEditing ? (
                <input
                  type="text"
                  value={editForm.businessName}
                  onChange={(e) => setEditForm({ ...editForm, businessName: e.target.value })}
                  className="text-2xl font-bold text-gray-900 border-2 border-purple-300 rounded-lg px-3 py-1"
                />
              ) : (
                <h1 className="text-2xl font-bold text-gray-900 flex items-center gap-2">
                  {vendor.businessName}
                  {vendor.verificationStatus === 'approved' && (
                    <BadgeCheck className="w-6 h-6 text-green-500" />
                  )}
                </h1>
              )}
              <p className="text-gray-500">@{vendor.username}</p>
            </div>
            
            <div className="flex items-center gap-3">
              {renderVerificationStatus()}
              <div className={`flex items-center gap-2 px-3 py-1.5 rounded-full ${tier.bg}`}>
                <TierIcon className={`w-4 h-4 ${tier.color}`} />
                <span className={`text-sm font-medium ${tier.color}`}>{tier.name}</span>
              </div>
            </div>
          </div>

          {/* Stats Grid */}
          <div className="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
            <div className="p-4 bg-gray-50 rounded-xl text-center">
              <Star className="w-6 h-6 text-yellow-500 mx-auto mb-2" />
              <p className="text-2xl font-bold text-gray-900">{vendor.rating}</p>
              <p className="text-sm text-gray-500">Rating</p>
            </div>
            <div className="p-4 bg-gray-50 rounded-xl text-center">
              <Award className="w-6 h-6 text-purple-500 mx-auto mb-2" />
              <p className="text-2xl font-bold text-gray-900">{vendor.totalSales}</p>
              <p className="text-sm text-gray-500">Total Sales</p>
            </div>
            <div className="p-4 bg-gray-50 rounded-xl text-center">
              <Calendar className="w-6 h-6 text-blue-500 mx-auto mb-2" />
              <p className="text-lg font-bold text-gray-900">{new Date(vendor.joinedDate).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}</p>
              <p className="text-sm text-gray-500">Member Since</p>
            </div>
            <div className="p-4 bg-gray-50 rounded-xl text-center">
              <Clock className={`w-6 h-6 mx-auto mb-2 ${daysUntilExpiry <= 7 ? 'text-red-500' : daysUntilExpiry <= 30 ? 'text-yellow-500' : 'text-green-500'}`} />
              <p className={`text-2xl font-bold ${daysUntilExpiry <= 7 ? 'text-red-600' : daysUntilExpiry <= 30 ? 'text-yellow-600' : 'text-green-600'}`}>
                {daysUntilExpiry}
              </p>
              <p className="text-sm text-gray-500">Days Until Expiry</p>
            </div>
          </div>

          {/* Account Expiry Warning */}
          {daysUntilExpiry <= 30 && (
            <div className={`p-4 rounded-xl mb-6 ${daysUntilExpiry <= 7 ? 'bg-red-50 border border-red-200' : 'bg-yellow-50 border border-yellow-200'}`}>
              <div className="flex items-start gap-3">
                <AlertTriangle className={`w-5 h-5 flex-shrink-0 ${daysUntilExpiry <= 7 ? 'text-red-500' : 'text-yellow-500'}`} />
                <div>
                  <p className={`font-semibold ${daysUntilExpiry <= 7 ? 'text-red-800' : 'text-yellow-800'}`}>
                    {daysUntilExpiry <= 7 ? '⚠️ Account Expiring Soon!' : '📅 Subscription Reminder'}
                  </p>
                  <p className={`text-sm ${daysUntilExpiry <= 7 ? 'text-red-600' : 'text-yellow-600'}`}>
                    Your subscription expires on {new Date(vendor.subscriptionExpiry).toLocaleDateString()}.
                    {daysUntilExpiry <= 7 ? ' Renew now to avoid service interruption.' : ' Consider renewing to maintain your vendor status.'}
                  </p>
                  <Link to="/vendor/subscription" className={`inline-block mt-2 px-4 py-2 rounded-lg font-medium ${daysUntilExpiry <= 7 ? 'bg-red-600 text-white' : 'bg-yellow-600 text-white'}`}>
                    Renew Subscription
                  </Link>
                </div>
              </div>
            </div>
          )}

          {/* Business Description */}
          <div className="mb-6">
            <h3 className="text-lg font-semibold text-gray-900 mb-2">About Business</h3>
            {isEditing ? (
              <textarea
                value={editForm.businessDescription}
                onChange={(e) => setEditForm({ ...editForm, businessDescription: e.target.value })}
                rows={4}
                className="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:ring-2 focus:ring-purple-500 resize-none"
              />
            ) : (
              <p className="text-gray-600">{vendor.businessDescription}</p>
            )}
          </div>

          {/* Contact Info */}
          <div className="grid md:grid-cols-2 gap-4">
            <div className="flex items-center gap-3 p-3 bg-gray-50 rounded-xl">
              <MapPin className="w-5 h-5 text-gray-400" />
              {isEditing ? (
                <input
                  type="text"
                  value={editForm.location}
                  onChange={(e) => setEditForm({ ...editForm, location: e.target.value })}
                  className="flex-1 bg-transparent border-b border-gray-300 focus:border-purple-500 outline-none"
                />
              ) : (
                <span className="text-gray-700">{vendor.location}</span>
              )}
            </div>
            <div className="flex items-center gap-3 p-3 bg-gray-50 rounded-xl">
              <Phone className="w-5 h-5 text-gray-400" />
              {isEditing ? (
                <input
                  type="tel"
                  value={editForm.phone}
                  onChange={(e) => setEditForm({ ...editForm, phone: e.target.value })}
                  className="flex-1 bg-transparent border-b border-gray-300 focus:border-purple-500 outline-none"
                />
              ) : (
                <span className="text-gray-700">{vendor.phone}</span>
              )}
            </div>
            <div className="flex items-center gap-3 p-3 bg-gray-50 rounded-xl">
              <Mail className="w-5 h-5 text-gray-400" />
              {isEditing ? (
                <input
                  type="email"
                  value={editForm.email}
                  onChange={(e) => setEditForm({ ...editForm, email: e.target.value })}
                  className="flex-1 bg-transparent border-b border-gray-300 focus:border-purple-500 outline-none"
                />
              ) : (
                <span className="text-gray-700">{vendor.email}</span>
              )}
            </div>
            <div className="flex items-center gap-3 p-3 bg-gray-50 rounded-xl">
              <Globe className="w-5 h-5 text-gray-400" />
              {isEditing ? (
                <input
                  type="url"
                  value={editForm.website}
                  onChange={(e) => setEditForm({ ...editForm, website: e.target.value })}
                  placeholder="https://example.com"
                  className="flex-1 bg-transparent border-b border-gray-300 focus:border-purple-500 outline-none"
                />
              ) : (
                <span className="text-gray-700">{vendor.website || 'Not set'}</span>
              )}
            </div>
          </div>
        </div>

        {/* Quick Actions */}
        <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
          <Link to="/vendor/manage-listings" className="p-4 bg-white rounded-xl shadow-sm hover:shadow-md transition-shadow text-center">
            <Eye className="w-8 h-8 text-purple-500 mx-auto mb-2" />
            <p className="font-medium text-gray-900">View Listings</p>
          </Link>
          <Link to="/vendor/analytics" className="p-4 bg-white rounded-xl shadow-sm hover:shadow-md transition-shadow text-center">
            <Award className="w-8 h-8 text-blue-500 mx-auto mb-2" />
            <p className="font-medium text-gray-900">Analytics</p>
          </Link>
          <Link to="/vendor/settings" className="p-4 bg-white rounded-xl shadow-sm hover:shadow-md transition-shadow text-center">
            <Shield className="w-8 h-8 text-green-500 mx-auto mb-2" />
            <p className="font-medium text-gray-900">Settings</p>
          </Link>
          <Link to="/vendor/subscription" className="p-4 bg-white rounded-xl shadow-sm hover:shadow-md transition-shadow text-center">
            <Crown className="w-8 h-8 text-yellow-500 mx-auto mb-2" />
            <p className="font-medium text-gray-900">Subscription</p>
          </Link>
        </div>
      </main>

      {/* Verification Modal */}
      {showVerificationModal && (
        <div className="fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4">
          <div className="bg-white rounded-2xl p-6 max-w-md w-full max-h-[90vh] overflow-y-auto">
            <div className="text-center mb-6">
              <div className="w-16 h-16 bg-purple-100 rounded-full flex items-center justify-center mx-auto mb-4">
                <Shield className="w-8 h-8 text-purple-600" />
              </div>
              <h3 className="text-xl font-bold text-gray-900">Get Verified</h3>
              <p className="text-gray-600 mt-2">
                Upload your business documents to get a verified badge
              </p>
            </div>

            <div className="bg-yellow-50 border border-yellow-200 rounded-xl p-4 mb-6">
              <div className="flex items-start gap-3">
                <Clock className="w-5 h-5 text-yellow-600 flex-shrink-0" />
                <div>
                  <p className="font-medium text-yellow-800">Processing Time</p>
                  <p className="text-sm text-yellow-700">
                    Verification may take up to <strong>4 working days</strong>. 
                    You'll be notified once your documents are reviewed.
                  </p>
                </div>
              </div>
            </div>

            <div className="mb-6">
              <h4 className="font-semibold text-gray-900 mb-3">Accepted Documents:</h4>
              <ul className="space-y-2 text-sm text-gray-600">
                <li className="flex items-center gap-2">
                  <CheckCircle className="w-4 h-4 text-green-500" />
                  Business License / Registration Certificate
                </li>
                <li className="flex items-center gap-2">
                  <CheckCircle className="w-4 h-4 text-green-500" />
                  Tax Identification Number (TIN) / Taxpayer's Card
                </li>
                <li className="flex items-center gap-2">
                  <CheckCircle className="w-4 h-4 text-green-500" />
                  Government-issued ID of business owner
                </li>
              </ul>
            </div>

            {/* Upload Area */}
            <div
              onClick={() => documentInputRef.current?.click()}
              className="border-2 border-dashed border-gray-300 rounded-xl p-6 text-center cursor-pointer hover:border-purple-400 transition-colors mb-4"
            >
              <Upload className="w-8 h-8 text-gray-400 mx-auto mb-2" />
              <p className="text-gray-600">Click to upload documents</p>
              <p className="text-sm text-gray-400">PDF, JPG, PNG (Max 5MB each)</p>
            </div>
            <input
              ref={documentInputRef}
              type="file"
              accept=".pdf,.jpg,.jpeg,.png"
              multiple
              onChange={handleDocumentUpload}
              className="hidden"
            />

            {/* Uploaded Files */}
            {uploadedDocuments.length > 0 && (
              <div className="mb-4">
                <h4 className="font-medium text-gray-900 mb-2">Uploaded Documents:</h4>
                <div className="space-y-2">
                  {uploadedDocuments.map((file, index) => (
                    <div key={index} className="flex items-center gap-2 p-2 bg-gray-50 rounded-lg">
                      <FileText className="w-4 h-4 text-gray-500" />
                      <span className="text-sm text-gray-700 truncate flex-1">{file.name}</span>
                      <button
                        onClick={() => setUploadedDocuments(prev => prev.filter((_, i) => i !== index))}
                        className="text-red-500 hover:text-red-700"
                      >
                        <XCircle className="w-4 h-4" />
                      </button>
                    </div>
                  ))}
                </div>
              </div>
            )}

            <div className="flex gap-3">
              <button
                onClick={() => { setShowVerificationModal(false); setUploadedDocuments([]); }}
                className="flex-1 py-3 bg-gray-100 text-gray-700 rounded-xl font-medium hover:bg-gray-200"
              >
                Cancel
              </button>
              <button
                onClick={handleSubmitVerification}
                disabled={uploadedDocuments.length === 0 || isUploading === 'document'}
                className="flex-1 py-3 bg-purple-600 text-white rounded-xl font-medium hover:bg-purple-700 disabled:opacity-50 flex items-center justify-center gap-2"
              >
                {isUploading === 'document' ? (
                  <><Loader2 className="w-4 h-4 animate-spin" />Submitting...</>
                ) : (
                  <><Shield className="w-4 h-4" />Submit for Review</>
                )}
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}
