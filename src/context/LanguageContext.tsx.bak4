// â”€â”€â”€ Types â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
type LanguageCode = "en" | "fr" | "pidgin" | "ar" | "ff";

type LanguageContextType = {
  language: LanguageCode;
  setLanguage: (lang: string) => void;
  t: (key: string) => string;
  isRtl: boolean;
};

// â”€â”€â”€ Context â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
const LanguageContext = createContext<LanguageContextType>({
  language: "en",
  setLanguage: () => {},
  t: (key) => key,
  isRtl: false,
});

// â”€â”€â”€ Storage key â€” unified across the entire app â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
const LANG_KEY = "Bambeh_language";

function resolveCode(raw: string | null): LanguageCode {
  const valid: LanguageCode[] = ["en", "fr", "pidgin", "ar", "ff"];
  // Accept aliases used by older LanguageSelection versions
  if (raw === "pcm" || raw === "pidgin_english") return "pidgin";
  if (raw === "ful" || raw === "fulfulde")        return "ff";
  if (valid.includes(raw as LanguageCode)) return raw as LanguageCode;
  return "en";
}

// â”€â”€â”€ Provider â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
export const LanguageProvider: React.FC<{ children: React.ReactNode }> = ({
  children,
}) => {
  const [language, setLanguageState] = useState<LanguageCode>(() =>
    resolveCode(localStorage.getItem(LANG_KEY))
  );

  const applyDocumentAttrs = useCallback((lang: LanguageCode) => {
    document.documentElement.dir  = lang === "ar" ? "rtl" : "ltr";
    document.documentElement.lang = lang;
  }, []);

  useEffect(() => {
    applyDocumentAttrs(language);

    // Sync across tabs / other parts of the app that write to localStorage
    const handleStorage = (e: StorageEvent) => {
      if (e.key === LANG_KEY && e.newValue) {
        const next = resolveCode(e.newValue);
        setLanguageState(next);
        applyDocumentAttrs(next);
      }
    };
    window.addEventListener("storage", handleStorage);
    return () => window.removeEventListener("storage", handleStorage);
  }, [language, applyDocumentAttrs]);

  const setLanguage = useCallback(
    (lang: string) => {
      const next = resolveCode(lang);
      setLanguageState(next);
      localStorage.setItem(LANG_KEY, next);
      applyDocumentAttrs(next);
    },
    [applyDocumentAttrs]
  );

  const t = useCallback(
    (key: string): string =>
      translations[language]?.[key] ??
      translations["en"]?.[key] ??
      key,
    [language]
  );

  return (
    <LanguageContext.Provider
      value={{ language, setLanguage, t, isRtl: language === "ar" }}
    >
      {children}
    </LanguageContext.Provider>
  );
};

export const useLanguage = () => useContext(LanguageContext);


